// Github 계정 이름
variable "github_access_token_owner" {
  description = "EC2 인스턴스 부팅 시 깃허브에서 소스 코드를 복제하고, GHCR에서 도커 이미지를 내려받기 위한 인증 정보"
  default     = ""
}

// Github Access Token
variable "github_access_token" {
  description = "EC2 인스턴스 부팅 시 깃허브에서 소스 코드를 복제하고, GHCR에서 도커 이미지를 내려받기 위한 인증 정보"
  default     = ""
}

// nginx, redis 비밀번호
variable "password" {
  description = "password"
  default     = ""
}

// 스프링에서 접속할 DB 계정명
variable "db_username" {
  description = "PostgreSQL DB 계정명"
  type        = string
  default     = "mori_user"
}
// 스프링에서 접속할 DB 비번
variable "db_password" {
  description = "PostgreSQL DB 비번"
  type        = string
  default     = "mori_pass"
}